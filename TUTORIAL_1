/* Find Length */
int length(char a[])
{
    int len = 0;

    while (a[len] != '\0')
    {
        len++;
    }

    return len;
}


/* Compare Two Strings */
void compare(char str[], char str2[])
{
    int i = 0;
    int flag = 0;

    while (str[i] != '\0' || str2[i] != '\0')
    {
        if (str[i] != str2[i])
        {
            flag = 1;
            break;
        }
        i++;
    }

    if (flag == 0)
        printf("Both Strings are equal\n");
    else
        printf("Both Strings are not equal\n");
}


/* Check Palindrome */
void palindrome(char a[])
{
    int l = length(a);
    int i;

    for (i = 0; i < l / 2; i++)
    {
        if (a[i] != a[l - i - 1])
        {
            printf("Not Palindrome\n");
            return;
        }
    }

    printf("Palindrome\n");
}


/* Check Substring */
void substring(char a[], char b[])
{
    int al = length(a);
    int bl = length(b);
    int i, j;
    int count = 0;

    if (bl > al)
    {
        printf("The String B is not substring of A\n");
        return;
    }

    for (i = 0; i <= al - bl; i++)
    {
        j = 0;

        while (j < bl && a[i + j] == b[j])
        {
            j++;
        }

        if (j == bl)
        {
            count++;
        }
    }

    if (count == 0)
    {
        printf("The String B is not substring of A\n");
    }
    else
    {
        printf("The String B is substring of A\n");
        printf("It occurs %d time(s)\n", count);
    }
}


/* Copy Second String into First String */
void copy(char a[], char b[])
{
    int i = 0;

    while (b[i] != '\0')
    {
        a[i] = b[i];
        i++;
    }

    a[i] = '\0';

    printf("Copied String is: %s\n", a);
}


/* Reverse String */
void reverse(char a[])
{
    int al = length(a);
    int i;
    char temp;

    for (i = 0; i < al / 2; i++)
    {
        temp = a[i];
        a[i] = a[al - i - 1];
        a[al - i - 1] = temp;
    }

    printf("Reverse String is: %s\n", a);
}
