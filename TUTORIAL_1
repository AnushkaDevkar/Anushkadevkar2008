#include <stdio.h>
#include <conio.h>

int length(char[]);
void compare(char[], char[]);
void palindrome(char[]);
void substring(char[], char[]);
void copy(char[], char[]);
void reverse(char[]);
void displayMenu();

int main()
{
    int choice;
    char str[50];
    char str2[50];
    int exit = 0;

    do
    {
        printf("\nENTER CHOICE (7 for Display Menu): ");
        scanf("%d", &choice);

        if (choice != 7 && choice != 8)
        {
            printf("Enter String: ");
            scanf("%s", str);
        }

        switch (choice)
        {
            case 1:
                printf("Length of the String is %d\n", length(str));
                break;

            case 2:
                printf("Enter second String: ");
                scanf("%s", str2);
                copy(str, str2);
                break;

            case 3:
                reverse(str);
                break;

            case 4:
                palindrome(str);
                break;

            case 5:
                printf("Enter substring String: ");
                scanf("%s", str2);
                substring(str, str2);
                break;

            case 6:
                printf("Enter second String: ");
                scanf("%s", str2);
                compare(str, str2);
                break;

            case 7:
                displayMenu();
                break;

            case 8:
                exit = 1;
                printf("Program exited.\n");
                break;

            default:
                printf("Invalid choice!\n");
        }

    } while (exit == 0);

    return 0;
}


